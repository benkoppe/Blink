# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

require "shellwords"

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:mac)

platform :mac do
  desc "Build mac app"
  lane :ci_build do |options|
    version = options[:version]
    UI.user_error!("No version found") unless version

    build_number = options[:build]
    UI.user_error!("No build number found") unless build_number

    bump_version(version_number: version)
    increment_build_number(build_number: build_number)

    xcode_select("/Applications/Xcode_26.3.app")
    gym()
  end

  desc "Run the macOS test suite without signing"
  lane :ci_tests do
    project_root = File.expand_path("..", __dir__)

    scan(
      project: File.join(project_root, "Blink.xcodeproj"),
      scheme: "Blink",
      configuration: "Debug",
      destination: "platform=macOS",
      derived_data_path: File.join(project_root, "build", "DerivedData"),
      # Set CI_CLEAN_BUILD=1 for an explicit clean verification. Normal PR runs
      # reuse DerivedData restored for the same toolchain and dependencies.
      clean: ENV["CI_CLEAN_BUILD"] == "1",
      output_directory: File.join(project_root, "build", "TestResults"),
      buildlog_path: File.join(project_root, "build", "Logs"),
      result_bundle: true,
      xcargs: "-skipMacroValidation CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO"
    )
  end

  desc "Build an unsigned Blink Dev artifact for pull requests"
  lane :pr_build do
    ci_tests

    project_root = File.expand_path("..", __dir__)
    app_path = File.join(project_root, "build", "DerivedData", "Build", "Products", "Debug", "Blink Dev.app")
    artifact_path = File.join(project_root, "build", "Blink-Dev.zip")
    UI.user_error!("Blink Dev.app was not produced at #{app_path}") unless File.directory?(app_path)

    revision = sh("git -C #{Shellwords.escape(project_root)} rev-parse HEAD", log: false).strip
    File.write(File.join(project_root, "build", "REVISION.txt"),
      "Built revision: #{revision}\nPR head: #{ENV.fetch('PR_HEAD_SHA', revision)}\n" \
      "CI validates and packages the proposed merge revision.\n")
    sh("ditto -c -k --sequesterRsrc --keepParent #{Shellwords.escape(app_path)} #{Shellwords.escape(artifact_path)}")
    UI.success("Created #{artifact_path}")
  end

  desc "Create a keychain and import the certificate for code signing"
  lane :cert_keychain do |options|
    cert_path = options[:path] 

    create_keychain(
      name: "CertKeychain",
      default_keychain: true,
      unlock: true,
      timeout: 0,
      password: ENV["KEYCHAIN_PASSWORD"] || "default"
    )
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV["CERT_PASSWORD"] || "default",
      keychain_name: "CertKeychain",
      keychain_password: ENV["KEYCHAIN_PASSWORD"] || "default"
    )
  end

  desc "Delete the keychain created for code signing"
  lane :delete_cert_keychain do
    delete_keychain(name: "CertKeychain")
  end

  desc "Bump version"
  lane :bump_version do |options|
    version_number = options[:version_number]
    UI.user_error!("No version found") unless version_number
    path = "../Blink.xcodeproj/project.pbxproj"
    if `sed --version 2>&1`.include?("GNU")
      sh(%Q(sed -i -e 's/MARKETING_VERSION \\= [^\\;]*\\;/MARKETING_VERSION = #{version_number};/' #{path}))
    else
      sh(%Q(sed -i '' -e 's/MARKETING_VERSION \\= [^\\;]*\\;/MARKETING_VERSION = #{version_number};/' #{path}))
    end
  end
end
